{
  "name": "developing-agent-forge",
  "version": "2.2.2",
  "description": "Goal-driven code development pipelines for coding agents, built on coding-agent-forge.",
  "repository": {
    "type": "git",
    "url": "https://github.com/yindaheng98/DevelopingAgentForge"
  },
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./agents": {
      "types": "./dist/agents/index.d.ts",
      "import": "./dist/agents/index.js"
    },
    "./pipeline": {
      "types": "./dist/pipeline/index.d.ts",
      "import": "./dist/pipeline/index.js"
    }
  },
  "bin": {
    "developing-agent-forge": "dist/cli.js"
  },
  "files": [
    "dist",
    "developing-forge.yaml",
    "skills",
    "metaskills",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "dev": "tsx src/cli.ts",
    "developing": "tsx src/cli.ts developing",
    "developing-skill": "tsx src/cli.ts developing-skill"
  },
  "dependencies": {
    "coding-agent-forge": "^1.3.1",
    "memory-agent-forge": "^1.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.4",
    "prettier": "^3.8.3",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0"
  }
}
